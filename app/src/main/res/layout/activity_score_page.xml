<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ScorePage">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/blue"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CODE CHECK"
            android:textSize="50sp"
            android:textAlignment="center"
            android:textColor="@color/white"
            android:fontFamily="@font/rye"
            android:layout_marginTop="-60dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tap Fast, Code Smart"
            android:textSize="20sp"
            android:textAlignment="center"
            android:textColor="@color/white"
            android:fontFamily="@font/lato_bold"/>

        <TextView
            android:id="@+id/categoryTV"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CATEGORY: JAVA"
            android:textSize="18sp"
            android:textAlignment="center"
            android:textColor="@color/white"
            android:fontFamily="@font/lato_bold"
            android:layout_marginTop="40dp"/>

        <TextView
            android:id="@+id/finalScoreTV"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="FINAL SCORE:"
            android:textSize="20sp"
            android:textAlignment="center"
            android:textColor="@color/white"
            android:fontFamily="@font/lato_bold"
            android:layout_marginTop="30dp"/>

        <TextView
            android:id="@+id/timeTakenTV"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="TIME TAKEN:"
            android:textSize="20sp"
            android:textAlignment="center"
            android:textColor="@color/white"
            android:fontFamily="@font/lato_bold"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="30dp"/>

        <Button
            android:id="@+id/againBtn"
            android:layout_width="180dp"
            android:layout_height="70dp"
            android:backgroundTint="@color/green"
            android:text="Play Again"
            android:textAllCaps="false"
            app:cornerRadius="12dp" />

        <Button
            android:id="@+id/homeBtn"
            android:layout_width="180dp"
            android:layout_height="70dp"
            android:text="Back to Home"
            android:textAllCaps="false"
            android:backgroundTint="@color/green"
            app:cornerRadius="12dp"
            android:layout_marginTop="12dp"/>

    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Version 1.0"
        android:textColor="@color/white"
        android:textSize="15sp"
        android:layout_gravity="bottom|end"
        android:layout_margin="10dp"/>
</FrameLayout>
