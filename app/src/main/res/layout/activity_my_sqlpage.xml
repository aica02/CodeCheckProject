<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/blue"
    tools:context=".MySQLPage">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp"
        android:layout_marginBottom="300dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2"
                android:paddingBottom="16dp">

                <TextView
                    android:id="@+id/tvTimer"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="TIME-LEFT: 10"
                    android:textSize="20sp"
                    android:textAlignment="center"
                    android:textColor="@color/white"
                    android:fontFamily="@font/lato_bold"/>

                <TextView
                    android:id="@+id/tvScore"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="SCORE: 10"
                    android:textSize="20sp"
                    android:textAlignment="center"
                    android:textColor="@color/white"
                    android:fontFamily="@font/lato_bold"/>
            </LinearLayout>

            <!-- Quiz Title and Question -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MYSQL"
                    android:textSize="50sp"
                    android:textAlignment="center"
                    android:textColor="@color/white"
                    android:fontFamily="@font/rye"
                    android:paddingBottom="8dp"
                    android:layout_marginTop="20dp"/>

                <ImageView
                    android:id="@+id/imageView2"
                    android:layout_width="match_parent"
                    android:layout_height="230dp"
                    app:srcCompat="@drawable/img" />
<!--                    android:layout_marginTop="-130dp"-->

                <TextView
                    android:id="@+id/tvCode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="SELECT name, age FROM students WHERE age > 20;"
                    android:textSize="18sp"
                    android:textAlignment="center"
                    android:textColor="@color/white"
                    android:fontFamily="@font/lato_bold"
                    android:background="@color/black"
                    android:padding="16dp"
                    android:layout_marginBottom="16dp"/>


            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Answer Buttons and Progress -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_gravity="bottom"
        android:padding="16dp"
        android:background="@color/blue">

        <ProgressBar
            android:id="@+id/progressBar"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="10dp"
            android:progress="20"
            android:progressTint="@color/green"
            android:layout_marginBottom="16dp"/>

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2"
            android:rowCount="2"
            android:alignmentMode="alignMargins"
            android:rowOrderPreserved="false"
            android:useDefaultMargins="true">

            <Button
                android:id="@+id/btn1"
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_columnWeight="1"
                android:layout_rowWeight="1"
                android:text="name | age\nAna | 20\nMark | 22"
                android:backgroundTint="@color/green"
                android:textColor="@color/white"
                android:padding="16dp"
                app:cornerRadius="10dp"/>

            <Button
                android:id="@+id/btn2"
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_columnWeight="1"
                android:layout_rowWeight="1"
                android:text="Error"
                android:backgroundTint="@color/green"
                android:textColor="@color/white"
                android:padding="16dp"
                app:cornerRadius="10dp"/>

            <Button
                android:id="@+id/btn3"
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_columnWeight="1"
                android:layout_rowWeight="1"
                android:text="No Output"
                android:backgroundTint="@color/green"
                android:textColor="@color/white"
                android:padding="16dp"
                app:cornerRadius="10dp"/>

            <Button
                android:id="@+id/btn4"
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_columnWeight="1"
                android:layout_rowWeight="1"
                android:text="name | age\nAna | 20"
                android:backgroundTint="@color/green"
                android:textColor="@color/white"
                android:padding="16dp"
                app:cornerRadius="10dp"/>
        </GridLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Version 1.0"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"/>
    </LinearLayout>

</FrameLayout>
