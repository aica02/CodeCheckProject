<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".HelpPage">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/blue"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CODE CHECK"
            android:textSize="45sp"
            android:textAlignment="center"
            android:textColor="@color/white"
            android:fontFamily="@font/rye"
            android:layout_marginTop="10dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tap Fast, Code Smart"
            android:textSize="18sp"
            android:textAlignment="center"
            android:textColor="@color/white"
            android:fontFamily="@font/lato_bold"
            android:layout_marginBottom="20dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="HELP and GUIDELINES"
            android:textSize="20sp"
            android:textAlignment="center"
            android:textColor="@color/white"
            android:fontFamily="@font/lato_bold"
            android:layout_marginBottom="15dp"/>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@color/green"
            android:padding="15dp">

            <TextView
                android:id="@+id/helpContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:lineSpacingExtra="4dp"
                android:lineSpacingMultiplier="1.2"
                android:text="ABOUT THE GAME\n\nCODE CHECK is a coding quiz game where you
    analyze code and choose the correct answer.
    \n\nHOW TO PLAY:\n1. The game displays a code snippet.
    \n2. You will see 4 answer choices.\n3. Select the correct answer.\n4. Each correct answer gives points.
    \n5. Wrong answers may reduce your score.
    \n\nCATEGORIES:\n• Java – Questions about Java programming.
    \n• CSS – Questions about web design and styling.
    \n• SQL – Questions about database queries.
    \n\nTIPS:\n• Read the code carefully.\n• Think logically before choosing.\n• Practice to improve your coding skills.
    \n\nGOAL:
    \nTest and improve your coding knowledge in a fun and interactive way!" />

        </ScrollView>

        <Button
            android:id="@+id/backBtn"
            android:layout_width="180dp"
            android:layout_height="70dp"
            android:text="Back"
            android:backgroundTint="@color/green"
            app:cornerRadius="10dp"
            android:layout_marginTop="15dp"/>

    </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>