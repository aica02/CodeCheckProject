<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/blue"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CODE CHECK"
            android:textSize="50sp"
            android:textAlignment="center"
            android:textColor="@color/white"
            android:fontFamily="@font/rye"
            android:layout_marginTop="20dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tap Fast, Code Smart"
            android:textSize="18sp"
            android:textAlignment="center"
            android:textColor="@color/white"
            android:fontFamily="@font/lato_bold"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="LEADERBOARDS"
            android:textSize="22sp"
            android:textAlignment="center"
            android:textColor="@color/white"
            android:fontFamily="@font/lato_bold"
            android:layout_marginTop="30dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="16dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/javaBtn"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="Java"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                app:backgroundTint="@color/green"
                app:cornerRadius="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/cssBtn"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="8dp"
                android:text="CSS"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                app:backgroundTint="@color/green"
                app:cornerRadius="12dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/mysqlBtn"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="MySQL"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                app:backgroundTint="@color/green"
                app:cornerRadius="12dp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Date | Score | Time | Difficulty "
                android:textSize="16sp"
                android:textAlignment="viewStart"
                android:textColor="@color/white"/>

            <Spinner
                android:id="@+id/difficultySpinner"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:spinnerMode="dropdown"
                android:layout_marginStart="10dp"/>
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/leaderboardRecycler"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:layout_marginTop="12dp"
            android:padding="4dp"
            android:clipToPadding="false"

            />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/homeBtn"
            android:layout_width="180dp"
            android:layout_height="60dp"
            android:text="Back to Home"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:backgroundTint="@color/green"
            app:cornerRadius="12dp"
            android:layout_marginTop="20dp"/>

    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Version 1.0"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:layout_gravity="bottom|end"
        android:layout_margin="10dp"/>

</FrameLayout>
